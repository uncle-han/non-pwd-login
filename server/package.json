{
  "name": "non-pwd-login-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "node src/app.js",
    "start:DEV": "set NODE_ENV=development&& node src/app.js",
    "start:UAT": "set NODE_ENV=uat&& node src/app.js",
    "start:PROD": "set NODE_ENV=production&& node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node src/database/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.22.5",
    "otplib": "^12.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
